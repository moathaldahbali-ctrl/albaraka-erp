import 'dart:io';
import 'dart:typed_data';
import 'package:flutter/services.dart' show rootBundle;
import 'package:intl/intl.dart';
import 'package:path/path.dart' as p;
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

class ReceiptLine {
  final String productName;
  final String sku;
  final String unitCode;
  final double quantity;
  final double unitPrice;
  final double subtotal;

  ReceiptLine({
    required this.productName,
    required this.sku,
    required this.unitCode,
    required this.quantity,
    required this.unitPrice,
    required this.subtotal,
  });
}

class ReceiptData {
  final String invoiceNumber;
  final DateTime occurredAt;
  final String paymentMethod;
  final String? customerName;
  final String? cashierName;
  final double total;
  final double paidAmount;
  final double changeAmount;
  final List<ReceiptLine> lines;

  ReceiptData({
    required this.invoiceNumber,
    required this.occurredAt,
    required this.paymentMethod,
    this.customerName,
    this.cashierName,
    required this.total,
    this.paidAmount = 0,
    this.changeAmount = 0,
    required this.lines,
  });
}

class ReceiptService {
  static const String _shopName = 'بقالة وبهارات البركة';
  static const String _shopTagline = 'جودة .. نكهة .. ثقة';
  static const String _shopAddress =
      'صنعاء - ش بيحان المتفرع من ش 22 مايو';
  static const String _shopPhone = '772025928';
  static const String _currency = 'ر.ي';

  static Future<Uint8List> generatePdf(ReceiptData data) async {
    final font = await PdfGoogleFonts.cairoRegular();
    final fontBold = await PdfGoogleFonts.cairoBold();

    // تحميل الشعار
    pw.MemoryImage? logo;
    try {
      final logoBytes = await rootBundle.load('assets/logo.png');
      logo = pw.MemoryImage(logoBytes.buffer
          .asUint8List(logoBytes.offsetInBytes, logoBytes.lengthInBytes));
    } catch (_) {
      logo = null;
    }

    final doc = pw.Document();

    doc.addPage(
      pw.Page(
        pageFormat: PdfPageFormat.a5,
        textDirection: pw.TextDirection.rtl,
        theme: pw.ThemeData.withFont(base: font, bold: fontBold),
        build: (ctx) {
          return pw.Column(
            crossAxisAlignment: pw.CrossAxisAlignment.stretch,
            children: [
              // ========== الرأس: الشعار ==========
              pw.Center(
                child: logo != null
                    ? pw.Image(logo, height: 80)
                    : pw.SizedBox(height: 80),
              ),
              pw.SizedBox(height: 4),

              // اسم البقالة
              pw.Center(
                child: pw.Text(
                  _shopName,
                  style: pw.TextStyle(
                    fontSize: 16,
                    fontWeight: pw.FontWeight.bold,
                    color: PdfColor.fromHex('#1B5E20'),
                  ),
                ),
              ),
              pw.SizedBox(height: 2),
              pw.Center(
                child: pw.Text(_shopTagline,
                    style: const pw.TextStyle(fontSize: 9)),
              ),
              pw.SizedBox(height: 2),
              pw.Center(
                child: pw.Text(_shopAddress,
                    style: const pw.TextStyle(fontSize: 9)),
              ),
              pw.SizedBox(height: 2),
              pw.Center(
                child: pw.Text('هاتف: ' + _shopPhone,
                    style: const pw.TextStyle(fontSize: 9)),
              ),
              pw.SizedBox(height: 8),
              pw.Divider(
                  thickness: 1.2, color: PdfColor.fromHex('#1B5E20')),

              // ========== عنوان الفاتورة ==========
              pw.Center(
                child: pw.Text(
                  data.paymentMethod == 'cash'
                      ? 'فاتورة بيع (نقد)'
                      : 'فاتورة بيع (أجل)',
                  style: pw.TextStyle(
                    fontSize: 13,
                    fontWeight: pw.FontWeight.bold,
                    color: PdfColor.fromHex('#1B5E20'),
                  ),
                ),
              ),
              pw.SizedBox(height: 6),

              // ========== معلومات الفاتورة ==========
              _infoGrid(data),
              pw.SizedBox(height: 8),
              pw.Divider(thickness: 0.7, color: PdfColors.grey500),

              // ========== الجدول ==========
              _buildLinesTable(data.lines),

              pw.SizedBox(height: 8),
              pw.Divider(thickness: 0.7, color: PdfColors.grey500),
              pw.SizedBox(height: 6),

              // ========== الإجمالي ==========
              _totalRow('الإجمالي', data.total, big: true),

              if (data.paymentMethod == 'cash') ...[
                pw.SizedBox(height: 4),
                _totalRow('المدفوع', data.paidAmount),
                pw.SizedBox(height: 3),
                _totalRow('المردود', data.changeAmount,
                    color: PdfColor.fromHex('#1565C0')),
              ],
              if (data.paymentMethod == 'credit') ...[
                pw.SizedBox(height: 4),
                _totalRow('المتبقي (دَين)', data.total,
                    color: PdfColor.fromHex('#C62828')),
              ],

              pw.SizedBox(height: 12),
              pw.Divider(thickness: 0.7, color: PdfColors.grey500),
              pw.SizedBox(height: 6),
              pw.Center(
                child: pw.Text(
                  'شكراً لتسوقكم معنا',
                  style: pw.TextStyle(
                    fontSize: 12,
                    fontWeight: pw.FontWeight.bold,
                    color: PdfColor.fromHex('#1B5E20'),
                  ),
                ),
              ),
              pw.SizedBox(height: 3),
              pw.Center(
                child: pw.Text(_shopName,
                    style: const pw.TextStyle(fontSize: 9)),
              ),
            ],
          );
        },
      ),
    );

    return doc.save();
  }

  /// شبكة معلومات الفاتورة (كل سطر: تسمية + قيمة، محاذاة يمين)
  static pw.Widget _infoGrid(ReceiptData data) {
    final rows = <List<String>>[
      ['التاريخ:', DateFormat('dd/MM/yyyy HH:mm').format(data.occurredAt)],
      ['رقم الفاتورة:', data.invoiceNumber],
      ['طريقة الدفع:', data.paymentMethod == 'cash' ? 'نقد' : 'أجل'],
      if (data.cashierName != null && data.cashierName!.isNotEmpty)
        ['الكاشير:', data.cashierName!],
      if (data.customerName != null && data.customerName!.isNotEmpty)
        ['العميل:', data.customerName!],
    ];

    return pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.stretch,
      children: rows
          .map((r) => pw.Padding(
                padding: const pw.EdgeInsets.symmetric(vertical: 1),
                child: pw.Align(
                  alignment: pw.Alignment.centerRight,
                  child: pw.RichText(
                    textDirection: pw.TextDirection.rtl,
                    text: pw.TextSpan(
                      children: [
                        pw.TextSpan(
                          text: r[0] + ' ',
                          style: pw.TextStyle(
                              fontSize: 10,
                              fontWeight: pw.FontWeight.bold),
                        ),
                        pw.TextSpan(
                          text: r[1],
                          style: const pw.TextStyle(fontSize: 10),
                        ),
                      ],
                    ),
                  ),
                ),
              ))
          .toList(),
    );
  }

  /// سطر إجمالي: التسمية يمين (RTL)، القيمة يسار
  static pw.Widget _totalRow(
    String label,
    double value, {
    bool big = false,
    PdfColor? color,
  }) {
    return pw.Container(
      padding: const pw.EdgeInsets.symmetric(vertical: 4, horizontal: 6),
      decoration: big
          ? pw.BoxDecoration(
              color: PdfColor.fromHex('#F1F8E9'),
              border: pw.Border.all(color: PdfColors.grey400, width: 0.5),
            )
          : null,
      child: pw.Row(
        children: [
          // القيمة أولاً (تظهر يسار)
          pw.Expanded(
            child: pw.Align(
              alignment: pw.Alignment.centerLeft,
              child: pw.Text(
                _fmtNum(value) + ' ' + _currency,
                style: pw.TextStyle(
                  fontSize: big ? 13 : 10,
                  fontWeight:
                      big ? pw.FontWeight.bold : pw.FontWeight.normal,
                  color: color,
                ),
              ),
            ),
          ),
          // التسمية ثانياً (تظهر يمين)
          pw.Expanded(
            child: pw.Align(
              alignment: pw.Alignment.centerRight,
              child: pw.Text(
                label,
                style: pw.TextStyle(
                  fontSize: big ? 12 : 10,
                  fontWeight:
                      big ? pw.FontWeight.bold : pw.FontWeight.normal,
                  color: color,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  /// جدول الأصناف (برأس أخضر فاتح + عمود "م")
  static pw.Widget _buildLinesTable(List<ReceiptLine> lines) {
    return pw.Table(
      border: pw.TableBorder.all(color: PdfColors.grey400, width: 0.5),
      columnWidths: {
        // ترتيب فيزيائي (يظهر معكوس بسبب RTL)
        0: const pw.FlexColumnWidth(1.0),   // م
        1: const pw.FlexColumnWidth(1.6),   // الرمز
        2: const pw.FlexColumnWidth(4.5),   // الصنف
        3: const pw.FlexColumnWidth(1.1),   // الوحدة
        4: const pw.FlexColumnWidth(1.2),   // الكمية
        5: const pw.FlexColumnWidth(1.6),   // السعر
        6: const pw.FlexColumnWidth(1.9),   // الإجمالي
      },
      children: [
        pw.TableRow(
          decoration:
              pw.BoxDecoration(color: PdfColor.fromHex('#C8E6C9')),
          children: [
            _cell('م', bold: true),
            _cell('الرمز', bold: true),
            _cell('الصنف', bold: true, align: pw.TextAlign.right),
            _cell('الوحدة', bold: true),
            _cell('الكمية', bold: true),
            _cell('السعر', bold: true),
            _cell('الإجمالي', bold: true),
          ],
        ),
        ...lines.asMap().entries.map((e) {
          final idx = e.key + 1;
          final l = e.value;
          return pw.TableRow(
            children: [
              _cell(idx.toString()),
              _cell(l.sku, fontSize: 8),
              _cell(l.productName, align: pw.TextAlign.right),
              _cell(l.unitCode),
              _cell(_fmtNum(l.quantity)),
              _cell(_fmtNum(l.unitPrice)),
              _cell(_fmtNum(l.subtotal)),
            ],
          );
        }),
      ],
    );
  }

  static pw.Widget _cell(
    String text, {
    bool bold = false,
    pw.TextAlign align = pw.TextAlign.center,
    double fontSize = 10,
  }) {
    return pw.Padding(
      padding: const pw.EdgeInsets.all(3),
      child: pw.Text(
        text,
        style: pw.TextStyle(
          fontSize: fontSize,
          fontWeight: bold ? pw.FontWeight.bold : pw.FontWeight.normal,
        ),
        textAlign: align,
      ),
    );
  }

  static String _fmtNum(double v) {
    if (v == v.roundToDouble()) {
      final s = v.toInt().toString();
      final buf = StringBuffer();
      for (int i = 0; i < s.length; i++) {
        if (i > 0 && (s.length - i) % 3 == 0) buf.write(',');
        buf.write(s[i]);
      }
      return buf.toString();
    }
    return v.toStringAsFixed(2);
  }

  static Future<String> savePdfToDisk(
      Uint8List bytes, String invoiceNumber) async {
    final dir = Directory(r'D:\albaraka\data\receipts');
    if (!await dir.exists()) {
      await dir.create(recursive: true);
    }
    final safeName =
        invoiceNumber.replaceAll('/', '_').replaceAll(':', '_');
    final fileName = safeName + '.pdf';
    final filePath = p.join(dir.path, fileName);
    await File(filePath).writeAsBytes(bytes);
    return filePath;
  }

  static Future<void> previewPdf(
      Uint8List bytes, String invoiceNumber) async {
    await Printing.layoutPdf(
      onLayout: (_) async => bytes,
      name: 'فاتورة ' + invoiceNumber,
    );
  }

  static Future<void> printPdf(
      Uint8List bytes, String invoiceNumber) async {
    await Printing.layoutPdf(
      onLayout: (_) async => bytes,
      name: 'فاتورة ' + invoiceNumber,
    );
  }
}