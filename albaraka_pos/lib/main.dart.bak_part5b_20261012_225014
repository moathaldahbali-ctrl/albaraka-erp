final GlobalKey<NavigatorState> navigatorKey = GlobalKey<NavigatorState>();
class AlbarakaApp extends StatefulWidget {
  const AlbarakaApp({super.key});

  @override
  State<AlbarakaApp> createState() => _AlbarakaAppState();
}

class _AlbarakaAppState extends State<AlbarakaApp> {
  final navigatorKey = GlobalKey<NavigatorState>();
  bool _checking = true;
  bool _loggedIn = false;

  // v9.4.6: Bootstrap state
  BootstrapResult? _bootstrapResult;
  bool _bootstrapRunning = true;

  @override
  void initState() {
    super.initState();
    _runBootstrap();
    _checkSession();
  }

  /// v9.4.6: تشغيل AppInitializer (non-blocking)
  Future<void> _runBootstrap() async {
    final result = await AppInitializer.instance.run(client: gqlClient);
    if (!mounted) return;
    setState(() {
      _bootstrapResult = result;
      _bootstrapRunning = false;
    });
    debugPrint('[Main] Bootstrap result: $result');
  }

  Future<void> _checkSession() async {
    try {
      final db = await LocalDatabase.instance.database;
      final rows = await db.query(
        'drafts_local',
        where: 'key = ?',
        whereArgs: ['current_user_id'],
        limit: 1,
      );
      if (!mounted) return;

      final hasUser = rows.isNotEmpty &&
          (rows.first['value'] as String?)?.isNotEmpty == true;

      setState(() {
        _loggedIn = false;
        _checking = false;
      });

      if (hasUser) {
        WidgetsBinding.instance.addPostFrameCallback((_) async {
          if (!mounted) return;
          await _onLoginSuccess();
        });
      }
    } catch (_) {
      if (!mounted) return;
      setState(() => _checking = false);
    }
  }

  Future<void> _onLoginSuccess() async {
    final db = await LocalDatabase.instance.database;
    final rows = await db.query(
      'drafts_local',
      where: 'key = ?',
      whereArgs: ['current_user_id'],
      limit: 1,
    );
    if (rows.isEmpty) {
      if (!mounted) return;
      setState(() => _loggedIn = true);
      return;
    }
    final cashierId = rows.first['value'] as String;

    final active = await LocalDatabase.instance.getActiveSession();
    if (active != null && active['cashier_id'] == cashierId) {
      if (!mounted) return;
      setState(() => _loggedIn = true);
      return;
    }

    if (!mounted) return;
    final navCtx = navigatorKey.currentContext;
    if (navCtx == null) {
      debugPrint('[Login] navCtx is null');
      if (!mounted) return;
      setState(() => _loggedIn = true);
      return;
    }
    if (!navCtx.mounted) return;
    final openingCash = await showDialog<double>(
      context: navCtx,
      barrierDismissible: false,
      builder: (_) => const OpeningCashDialog(),
    );

    if (openingCash == null) return;

    try {
      await LocalDatabase.instance.openSession(
        cashierId: cashierId,
        openingCash: openingCash,
        cashRegisterId: LocalDatabase.kCashRegisterId,
        posDeviceId: LocalDatabase.kPosDeviceId,
        branchId: LocalDatabase.kBranchId,
        warehouseId: LocalDatabase.kWarehouseId,
      );
    } catch (e) {
      debugPrint('[Login] openSession failed: $e');
      if (!mounted) return;
      ScaffoldMessenger.of(navigatorKey.currentContext ?? context).showSnackBar(
        SnackBar(content: Text('openSession failed: $e')),
      );
      return;
    }

    if (!mounted) return;
    setState(() => _loggedIn = true);
  }

  Future<void> _logout() async {
    try {
      final db = await LocalDatabase.instance.database;
      await db.delete(
        'drafts_local',
        where: 'key = ?',
        whereArgs: ['current_user_id'],
      );
    } catch (_) {}
    if (!mounted) return;
    setState(() => _loggedIn = false);
  }

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<int>(
      valueListenable: ThemeProvider.instance.revision,
      builder: (context, themeId, _) {
        return ValueListenableBuilder<ThemeMode>(
          valueListenable: ThemeProvider.instance.themeMode,
          builder: (context, themeMode, _) {
            final preset = ThemeProvider.instance.current;
            return MaterialApp(
              navigatorKey: navigatorKey,
              title: 'Albaraka',
              debugShowCheckedModeBanner: false,
              theme: AppTheme.build(preset, Brightness.light),
              darkTheme: AppTheme.build(preset, Brightness.dark),
              themeMode: themeMode,
              locale: const Locale('ar'),
              builder: (context, child) {
                return Directionality(
                  textDirection: TextDirection.rtl,
                  child: child ?? const SizedBox.shrink(),
                );
              },
              home: _buildHome(),
            );
          },
        );
      },
    );
  }

  Widget _buildHome() {
    // v9.4.6: عرض SplashScreen أثناء Bootstrap
    if (_bootstrapRunning) {
      return SplashScreen(result: _bootstrapResult);
    }

    // Bootstrap فشل — Splash مع زر إعادة
    if (_bootstrapResult != null &&
        _bootstrapResult!.status == BootstrapStatus.failed) {
      return SplashScreen(
        result: _bootstrapResult,
        onRetry: () {
          setState(() {
            _bootstrapRunning = true;
            _bootstrapResult = null;
          });
          _runBootstrap();
        },
      );
    }

    // Bootstrap تم — نتحقق من الجلسة
    if (_checking) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator()),
      );
    }
    if (!_loggedIn) {
      return LoginScreen(onLoginSuccess: _onLoginSuccess);
    }
    return HomePage(onLogout: _logout);
  }
}

