  static pw.Widget _infoGrid(ReceiptData data) {
    final rows = <List<String>>[
      [
        '\u0627\u0644\u062a\u0627\u0631\u064a\u062e:',
        DateFormat('dd/MM/yyyy HH:mm').format(data.occurredAt)
      ],
      [
        '\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629:',
        data.invoiceNumber
      ],
      [
        '\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639:',
        data.paymentMethod == 'cash'
            ? '\u0646\u0642\u062f'
            : '\u0623\u062c\u0644'
      ],
      if (data.cashierName != null && data.cashierName!.isNotEmpty)
        ['\u0627\u0644\u0643\u0627\u0634\u064a\u0631:', data.cashierName!],
      if (data.customerName != null && data.customerName!.isNotEmpty)
        ['\u0627\u0644\u0639\u0645\u064a\u0644:', data.customerName!],
    ];

    return pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.stretch,
      children: rows
          .map((r) => pw.Padding(
                padding: const pw.EdgeInsets.symmetric(vertical: 1),
                child: pw.Align(
                  alignment: pw.Alignment.centerRight,
                  child: pw.RichText(
                    textDirection: pw.TextDirection.rtl,
                    text: pw.TextSpan(
                      children: [
                        pw.TextSpan(
                          text: r[0] + ' ',
                          style: pw.TextStyle(
                              fontSize: 10, fontWeight: pw.FontWeight.bold),
                        ),
                        pw.TextSpan(
                          text: r[1],
                          style: const pw.TextStyle(fontSize: 10),
                        ),
                      ],
                    ),
                  ),
                ),
              ))
          .toList(),
    );
  }

  static pw.Widget _totalRow(
    String label,
    double value, {
    bool big = false,
    PdfColor? color,
  }) {
    return pw.Container(
      padding: const pw.EdgeInsets.symmetric(vertical: 4, horizontal: 6),
      decoration: big
          ? pw.BoxDecoration(
              color: PdfColor.fromHex('#F1F8E9'),
              border: pw.Border.all(color: PdfColors.grey400, width: 0.5),
            )
          : null,
      child: pw.Row(
        children: [
          pw.Expanded(
            child: pw.Align(
              alignment: pw.Alignment.centerLeft,
              child: pw.Text(
                _fmtNum(value) + ' ' + _currency,
                style: pw.TextStyle(
                  fontSize: big ? 13 : 10,
                  fontWeight:
                      big ? pw.FontWeight.bold : pw.FontWeight.normal,
                  color: color,
                ),
              ),
            ),
          ),
          pw.Expanded(
            child: pw.Align(
              alignment: pw.Alignment.centerRight,
              child: pw.Text(
                label,
                style: pw.TextStyle(
                  fontSize: big ? 12 : 10,
                  fontWeight:
                      big ? pw.FontWeight.bold : pw.FontWeight.normal,
                  color: color,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  static pw.Widget _buildLinesTable(List<ReceiptLine> lines) {
    return pw.Table(
      border: pw.TableBorder.all(color: PdfColors.grey400, width: 0.5),
      columnWidths: {
        0: const pw.FlexColumnWidth(1.0),
        1: const pw.FlexColumnWidth(1.6),
        2: const pw.FlexColumnWidth(4.5),
        3: const pw.FlexColumnWidth(1.1),
        4: const pw.FlexColumnWidth(1.2),
        5: const pw.FlexColumnWidth(1.6),
        6: const pw.FlexColumnWidth(1.9),
      },
      children: [
        pw.TableRow(
          decoration:
              pw.BoxDecoration(color: PdfColor.fromHex('#C8E6C9')),
          children: [
            _cell('\u0645', bold: true),
            _cell('\u0627\u0644\u0631\u0645\u0632', bold: true),
            _cell('\u0627\u0644\u0635\u0646\u0641',
                bold: true, align: pw.TextAlign.right),
            _cell('\u0627\u0644\u0648\u062d\u062f\u0629', bold: true),
            _cell('\u0627\u0644\u0643\u0645\u064a\u0629', bold: true),
            _cell('\u0627\u0644\u0633\u0639\u0631', bold: true),
            _cell('\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a',
                bold: true),
          ],
        ),
        ...lines.asMap().entries.map((e) {
          final idx = e.key + 1;
          final l = e.value;
          return pw.TableRow(
            children: [
              _cell(idx.toString()),
              _cell(l.sku, fontSize: 8),
              _cell(l.productName, align: pw.TextAlign.right),
              _cell(l.unitCode),
              _cell(_fmtNum(l.quantity)),
              _cell(_fmtNum(l.unitPrice)),
              _cell(_fmtNum(l.subtotal)),
            ],
          );
        }),
      ],
    );
  }

  static pw.Widget _cell(
    String text, {
    bool bold = false,
    pw.TextAlign align = pw.TextAlign.center,
    double fontSize = 10,
  }) {
    return pw.Padding(
      padding: const pw.EdgeInsets.all(3),
      child: pw.Text(
        text,
        style: pw.TextStyle(
          fontSize: fontSize,
          fontWeight: bold ? pw.FontWeight.bold : pw.FontWeight.normal,
        ),
        textAlign: align,
      ),
    );
  }

  static String _fmtNum(double v) {
    if (v == v.roundToDouble()) {
      final s = v.toInt().toString();
      final buf = StringBuffer();
      for (int i = 0; i < s.length; i++) {
        if (i > 0 && (s.length - i) % 3 == 0) buf.write(',');
        buf.write(s[i]);
      }
      return buf.toString();
    }
    return v.toStringAsFixed(2);
  }

  static Future<String> savePdfToDisk(
      Uint8List bytes, String invoiceNumber) async {
    final dir = Directory(r'D:\albaraka\data\receipts');
    if (!await dir.exists()) {
      await dir.create(recursive: true);
    }
    final safeName =
        invoiceNumber.replaceAll('/', '_').replaceAll(':', '_');
    final fileName = safeName + '.pdf';
    final filePath = p.join(dir.path, fileName);
    await File(filePath).writeAsBytes(bytes);
    return filePath;
  }

  static Future<void> previewPdf(
      Uint8List bytes, String invoiceNumber) async {
    await Printing.layoutPdf(
      onLayout: (_) async => bytes,
      name: 'Invoice ' + invoiceNumber,
    );
  }

  static Future<void> printPdf(
      Uint8List bytes, String invoiceNumber) async {
    await Printing.layoutPdf(
      onLayout: (_) async => bytes,
      name: 'Invoice ' + invoiceNumber,
    );
  }
}