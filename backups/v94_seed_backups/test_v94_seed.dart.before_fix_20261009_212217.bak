import 'dart:io';
import 'package:sqflite_common_ffi/sqflite_ffi.dart';
import 'package:path/path.dart' as p;
import '../lib/data/migrations/v14_permissions.dart';
import '../lib/data/seed_runner.dart';
import '../lib/services/permission_service.dart';

Future<void> main() async {
  sqfliteFfiInit();
  databaseFactory = databaseFactoryFfi;

  final dbPath = r'D:\v94_test\albaraka_local.db';
  Directory(p.dirname(dbPath)).createSync(recursive: true);

  // لو الملف موجود من قبل، احذفه لإعادة الاختبار
  final f = File(dbPath);
  if (await f.exists()) {
    await f.delete();
    print('Deleted old test DB');
  }

  final db = await databaseFactory.openDatabase(
    dbPath,
    options: OpenDatabaseOptions(
      version: 14,
      onCreate: (db, v) async {
        await migrateV13ToV14(db);
      },
    ),
  );

  print('DB opened: $dbPath');
  await SeedRunner(db).run();

  final permCount = Sqflite.firstIntValue(
    await db.rawQuery('SELECT COUNT(*) FROM permissions_local')
  );
  final roleCount = Sqflite.firstIntValue(
    await db.rawQuery('SELECT COUNT(*) FROM roles_local')
  );
  final cashierCount = Sqflite.firstIntValue(
    await db.rawQuery("SELECT COUNT(*) FROM role_permissions_local WHERE role_id='Cashier'")
  );

  print('--------------------------');
  print('Permissions: $permCount (expect 206)');
  print('Roles:       $roleCount (expect 5)');
  print('Cashier:     $cashierCount (expect 7)');
  print('--------------------------');

  final svc = PermissionService(db);
  final canCreate = await svc.hasPermission('cashier1', 'ops.sales_invoice.create');
  final canDelete = await svc.hasPermission('cashier1', 'ops.sales_invoice.delete');
  print('Cashier can create invoice: $canCreate (expect true)');
  print('Cashier can delete invoice: $canDelete (expect false)');

  await db.close();
  print('v9.4.2 test complete');
}