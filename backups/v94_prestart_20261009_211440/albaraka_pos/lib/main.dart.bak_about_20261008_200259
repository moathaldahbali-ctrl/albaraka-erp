final GraphQLClient gqlClient = GraphQLClient(
  link: HttpLink(
    'https://eewgyrglhvkxjwzevcwm.hasura.ap-southeast-1.nhost.run/v1/graphql',
    defaultHeaders: {
      'x-hasura-admin-secret': dotenv.env['HASURA_ADMIN_SECRET'] ?? '',
