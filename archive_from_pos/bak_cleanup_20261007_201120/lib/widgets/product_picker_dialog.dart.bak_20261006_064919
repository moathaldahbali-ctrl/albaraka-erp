import 'package:flutter/material.dart';

class ProductPickerDialog extends StatefulWidget {
  final Future<List<Map<String, dynamic>>> Function(String query) search;
  const ProductPickerDialog({super.key, required this.search});

  @override
  State<ProductPickerDialog> createState() => _ProductPickerDialogState();
}

class _ProductPickerDialogState extends State<ProductPickerDialog> {
  final TextEditingController _ctrl = TextEditingController();
  List<Map<String, dynamic>> _items = [];
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _run('');
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  Future<void> _run(String q) async {
    setState(() => _loading = true);
    try {
      final list = await widget.search(q);
      if (!mounted) return;
      setState(() {
        _items = list;
        _loading = false;
      });
    } catch (e) {
      debugPrint('product search error: $e');
      if (!mounted) return;
      setState(() {
        _items = [];
        _loading = false;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Dialog(
      child: ConstrainedBox(
        constraints: const BoxConstraints(maxWidth: 720, maxHeight: 640),
        child: Column(
          children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
              color: Colors.grey.shade200,
              child: Row(
                children: [
                  const Icon(Icons.inventory_2),
                  const SizedBox(width: 8),
                  const Text('\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646\u062a\u062c',
                      style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
                  const Spacer(),
                  Text('${_items.length}',
                      style: TextStyle(color: Colors.grey.shade600)),
                  const SizedBox(width: 8),
                  IconButton(
                    icon: const Icon(Icons.close),
                    onPressed: () => Navigator.pop(context),
                  ),
                ],
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(12),
              child: TextField(
                controller: _ctrl,
                autofocus: true,
                onChanged: (v) => _run(v),
                decoration: const InputDecoration(
                  hintText:
                      '\u0627\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645 \u0623\u0648 \u0627\u0644\u0631\u0645\u0632...',
                  prefixIcon: Icon(Icons.search),
                  isDense: true,
                  border: OutlineInputBorder(),
                ),
              ),
            ),
            const Divider(height: 1),
            Expanded(
              child: _loading
                  ? const Center(child: CircularProgressIndicator())
                  : _items.isEmpty
                      ? const Center(
                          child: Text('\u0644\u0627 \u0646\u062a\u0627\u0626\u062c'))
                      : ListView.separated(
                          itemCount: _items.length,
                          separatorBuilder: (_, __) => const Divider(height: 1),
                          itemBuilder: (context, i) {
                            final p = _items[i];
                            final name =
                                (p['name'] as String? ?? '').toString();
                            final sku =
                                (p['sku'] as String? ?? '').toString();
                            final unit =
                                (p['unit_id'] as String? ?? '').toString();
                            final price =
                                (p['sale_price'] as num?)?.toDouble() ?? 0;
                            final stock =
                                (p['stock_qty'] as num?)?.toDouble();
                            return ListTile(
                              dense: true,
                              leading: CircleAvatar(
                                radius: 18,
                                child: Text('#$sku',
                                    style: const TextStyle(fontSize: 9)),
                              ),
                              title: Text(name,
                                  style: const TextStyle(
                                      fontWeight: FontWeight.w600)),
                              subtitle: Row(
                                children: [
                                  if (unit.isNotEmpty)
                                    Text(unit,
                                        style: TextStyle(
                                            fontSize: 12,
                                            color: Colors.grey.shade700)),
                                  if (unit.isNotEmpty && stock != null)
                                    const Text(' \u00b7 '),
                                  if (stock != null)
                                    Text(
                                      '\u0645\u062a\u0627\u062d: ${stock.toStringAsFixed(2)}',
                                      style: TextStyle(
                                          fontSize: 12,
                                          color: stock <= 0
                                              ? Colors.red
                                              : Colors.grey.shade700),
                                    ),
                                ],
                              ),
                              trailing: Text('${price.toStringAsFixed(0)} YER',
                                  style: const TextStyle(
                                      color: Colors.green,
                                      fontWeight: FontWeight.bold,
                                      fontSize: 13)),
                              onTap: () => Navigator.pop(context, p),
                            );
                          },
                        ),
            ),
          ],
        ),
      ),
    );
  }
}